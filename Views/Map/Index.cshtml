@{
    ViewData["Title"] = "World Map";
}

<div class="map-page-container">
    <!-- Header bar: Progress & Level -->
    <div class="map-header card shadow-sm mb-3">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 border border-secondary" id="player-level-badge">
                    ⚔ Level 1
                </span>
                <span class="fw-bold text-secondary" id="world-discovered-text">
                    12.4% of the world discovered
                </span>
            </div>

            <div class="flex-grow-1 mx-md-3" style="min-width: 180px; max-width: 380px;">
                <div class="progress" style="height: 14px; background-color: #d8ceb9;">
                    <div id="world-progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 12.4%;" aria-valuenow="12.4" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary" id="btn-zoom-in" title="Zoom In">+</button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-zoom-out" title="Zoom Out">−</button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-zoom-reset" title="Reset View">⟲</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Legend -->
    <div class="d-flex flex-wrap align-items-center gap-3 mb-2 small text-muted px-1">
        <span class="d-flex align-items-center gap-1">
            <span class="legend-box legend-discovered"></span> Explored / In Progress
        </span>
        <span class="d-flex align-items-center gap-1">
            <span class="legend-box legend-fog"></span> Fog of War (0%)
        </span>
        <span class="d-flex align-items-center gap-1">
            <span class="legend-box legend-unexplored"></span> No lessons yet
        </span>
    </div>

    <!-- Map Viewport with Parchment Styling -->
    <div class="map-viewport-wrapper border rounded shadow position-relative">
        <div id="map-loading-spinner" class="position-absolute top-50 start-50 translate-middle text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted fw-bold">Unrolling world map...</div>
        </div>
        <div id="map-tooltip" class="map-tooltip"></div>
        <svg id="world-map-svg" viewBox="0 0 960 500" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
</div>

<style>
    .map-page-container {
        font-family: 'Georgia', serif;
    }

    .map-header {
        background-color: #f7f3e8;
        border: 1px solid #d4c8b0;
    }

    .map-viewport-wrapper {
        background: #ede3cb radial-gradient(circle, #fcf9ee 0%, #e2d2b0 100%);
        border: 2px solid #8d7756 !important;
        overflow: hidden;
        min-height: 480px;
        position: relative;
    }

    #world-map-svg {
        width: 100%;
        height: 100%;
        min-height: 480px;
        display: block;
        cursor: grab;
    }

    #world-map-svg:active {
        cursor: grabbing;
    }

    .country {
        stroke: #9d8768;
        stroke-width: 0.5px;
        transition: fill 0.2s ease, opacity 0.2s ease;
    }

    .country:hover {
        stroke: #2b2010;
        stroke-width: 1.2px;
        filter: brightness(1.08);
    }

    .country-fogged {
        fill: #6d665b;
        opacity: 0.85;
    }

    .country-unexplored {
        fill: #8f8474;
        opacity: 0.45;
        stroke-dasharray: 2, 2;
    }

    .legend-box {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        border: 1px solid #7c6c56;
    }

    .legend-discovered {
        background-color: #2e7d32;
    }

    .legend-fog {
        background-color: #6d665b;
    }

    .legend-unexplored {
        background-color: #c2b6a0;
    }

    .map-tooltip {
        position: absolute;
        pointer-events: none;
        background: rgba(36, 26, 17, 0.92);
        color: #f8f1e5;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 0.85rem;
        display: none;
        z-index: 100;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        border: 1px solid #d2b48c;
    }
</style>

@section Scripts {
    <script src="~/lib/d3/d3.min.js"></script>
    <script src="~/lib/topojson/topojson.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const width = 960;
            const height = 500;

            const svg = d3.select("#world-map-svg");
            const g = svg.append("g").attr("class", "map-layers");
            const tooltip = d3.select("#map-tooltip");
            const spinner = document.getElementById("map-loading-spinner");

            // Setup zoom behavior
            const zoom = d3.zoom()
                .scaleExtent([1, 8])
                .on("zoom", (event) => {
                    g.attr("transform", event.transform);
                });

            svg.call(zoom);

            document.getElementById("btn-zoom-in").addEventListener("click", () => {
                svg.transition().duration(300).call(zoom.scaleBy, 1.3);
            });
            document.getElementById("btn-zoom-out").addEventListener("click", () => {
                svg.transition().duration(300).call(zoom.scaleBy, 0.7);
            });
            document.getElementById("btn-zoom-reset").addEventListener("click", () => {
                svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity);
            });

            // Projection & Path
            const projection = d3.geoNaturalEarth1()
                .scale(153)
                .translate([width / 2, height / 2]);

            const path = d3.geoPath().projection(projection);

            try {
                // Fetch country progress and local TopoJSON map concurrently
                const [progressRes, topoData] = await Promise.all([
                    fetch('/api/progress/countries').then(r => r.ok ? r.json() : {}).catch(() => ({})),
                    fetch('/lib/world-atlas/countries-50m.json').then(r => r.json())
                ]);

                spinner.style.display = 'none';

                const countries = topojson.feature(topoData, topoData.objects.countries).features;

                // Color scale for discovered countries
                const colorScale = d3.scaleLinear()
                    .domain([0, 100])
                    .range(["#7a8050", "#2e7d32"]);

                g.selectAll("path")
                    .data(countries)
                    .enter()
                    .append("path")
                    .attr("class", d => {
                        const iso = String(d.id).padStart(3, '0');
                        if (progressRes[iso] !== undefined) {
                            return progressRes[iso] > 0 ? "country" : "country country-fogged";
                        }
                        return "country country-unexplored";
                    })
                    .attr("d", path)
                    .attr("fill", d => {
                        const iso = String(d.id).padStart(3, '0');
                        if (progressRes[iso] !== undefined) {
                            const pct = progressRes[iso];
                            return pct > 0 ? colorScale(pct) : "#6d665b";
                        }
                        return "#b9ab93";
                    })
                    .attr("opacity", d => {
                        const iso = String(d.id).padStart(3, '0');
                        if (progressRes[iso] !== undefined) {
                            const pct = progressRes[iso];
                            // Fog of war effect: higher percentage -> clearer visibility
                            return pct > 0 ? (0.4 + (pct / 100) * 0.6) : 0.6;
                        }
                        return 0.35;
                    })
                    .on("mousemove", (event, d) => {
                        const iso = String(d.id).padStart(3, '0');
                        const countryName = d.properties?.name || `Country #${d.id}`;
                        let progressText = "Unexplored (No lessons yet)";

                        if (progressRes[iso] !== undefined) {
                            progressText = `${progressRes[iso]}% discovered`;
                        }

                        const wrapperRect = document.querySelector(".map-viewport-wrapper").getBoundingClientRect();
                        const x = event.clientX - wrapperRect.left + 15;
                        const y = event.clientY - wrapperRect.top + 15;

                        tooltip.style("display", "block")
                            .style("left", `${x}px`)
                            .style("top", `${y}px`)
                            .html(`<strong>${countryName}</strong><br/><small>${progressText}</small>`);
                    })
                    .on("mouseleave", () => {
                        tooltip.style("display", "none");
                    });

            } catch (err) {
                console.error("Failed to load map data:", err);
                spinner.innerHTML = `<span class="text-danger">Failed to load world map: ${err.message}</span>`;
            }
        });
    </script>
}
