@{
    ViewData["Title"] = "Learn history, uncover the world";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

@if (!signedIn)
{
    <section class="landing text-center">
        <h1 class="display-5 fw-bold">The world is covered in fog.</h1>
        <p class="lead mx-auto">
            Histador turns history into a game. Take short lessons of 5–15 minutes on the events and countries that shaped
            the world, pass the quiz, and watch the fog lift from every country involved. Then test yourself against
            friends in live quiz duels and climb from Peasant to God.
        </p>
        <div class="landing-steps row g-3 my-4 text-start">
            <div class="col-md-4"><div class="p-3 border rounded h-100"><strong>📜 Learn</strong><br />Only the important parts and the best facts.</div></div>
            <div class="col-md-4"><div class="p-3 border rounded h-100"><strong>🗺️ Discover</strong><br />Every lesson you pass reveals part of the world map.</div></div>
            <div class="col-md-4"><div class="p-3 border rounded h-100"><strong>⚔️ Duel</strong><br />Challenge players and earn your rank.</div></div>
        </div>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">Start learning</a>
        <p class="mt-3 small">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></p>
    </section>
}
else
{
    <section class="text-center py-5">
        <h1 class="h2">Welcome back, @User.FindFirst(HistadorClaimsPrincipalFactory.DisplayNameClaim)?.Value!</h1>
        <p class="text-muted">The map and lessons are coming soon.</p>
    </section>
}
