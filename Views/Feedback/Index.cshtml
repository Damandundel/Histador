@{
    ViewData["Title"] = "Send feedback";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <h1 class="h2 mb-2">Send feedback</h1>
        <p class="text-muted mb-4">
            Found a problem or have an idea? Tell us. We read every message.
        </p>

        <div id="feedback-status" class="mb-3" aria-live="polite"></div>

        <form id="feedback-form" novalidate>
            <fieldset class="mb-3" id="feedback-type-group">
                <legend class="form-label fs-6 fw-semibold">What kind of feedback is it?</legend>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="type" id="feedback-type-problem" value="1" />
                    <label class="form-check-label" for="feedback-type-problem">Problem</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="type" id="feedback-type-suggestion" value="2" />
                    <label class="form-check-label" for="feedback-type-suggestion">Suggestion</label>
                </div>

                <div id="feedback-type-error" class="text-danger small mt-1" aria-live="polite"></div>
            </fieldset>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="feedback-content">Your message</label>
                <textarea class="form-control" id="feedback-content" name="content" rows="6"
                          maxlength="1000" aria-describedby="feedback-content-help feedback-content-error"></textarea>

                <div class="d-flex justify-content-between align-items-baseline">
                    <div id="feedback-content-help" class="form-text">Between 10 and 1000 characters.</div>
                    <div id="feedback-counter" class="form-text feedback-counter">0 / 1000</div>
                </div>

                <div id="feedback-content-error" class="text-danger small mt-1" aria-live="polite"></div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="submit" id="feedback-submit" class="btn btn-primary" disabled>Send</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
            </div>

            <noscript>
                <p class="text-danger mt-3 mb-0">JavaScript is required to send feedback.</p>
            </noscript>
        </form>

        @* TODO: localize the page text when the localization work lands. *@
    </div>
</div>

@section Scripts {
    <script src="~/js/feedback.js" asp-append-version="true"></script>
}
