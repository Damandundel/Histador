@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-1">Forgot your password?</h1>
        <p class="text-muted mb-3">Enter your email and we'll send you a link to reset it.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </form>
        <p class="mt-3 small mb-0"><a asp-action="Login">Back to log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
