@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-2">Check your email</h1>
        <p class="mb-3">If an account exists for that address, we've sent a link to reset your password.</p>
        <a asp-action="Login" class="btn btn-outline-primary w-100">Back to log in</a>
    </div>
</div>
