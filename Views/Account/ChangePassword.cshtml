@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="auth-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-3">Change password</h1>
        @if (TempData["StatusMessage"] is string status)
        {
            <div class="alert alert-success" role="status">@status</div>
        }
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label"></label>
                <input asp-for="OldPassword" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Update password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
