@{
    ViewData["Title"] = "Password reset";
}

<div class="auth-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-2">Password reset</h1>
        <p class="mb-3">Your password has been reset. You can log in with your new password.</p>
        <a asp-action="Login" class="btn btn-primary w-100">Log in</a>
    </div>
</div>
